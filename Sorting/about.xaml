<Window x:Class="Sorting.about"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="about" Height="285" Width="391" ResizeMode="NoResize" FlowDirection="LeftToRight" Loaded="Window_Loaded_1" WindowStartupLocation="CenterScreen" Icon="about.png" Background="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Image Margin="129,10,128,0" Height="128" VerticalAlignment="Top" Source="Icon.png"/>
        <Label Content="mohammad.diab93@outlook.com " Margin="84,0,0,43" VerticalAlignment="Bottom" FontSize="14" FontFamily="Segoe Print" Height="35" Foreground="Red" HorizontalAlignment="Left" Width="260"/>
        <Label x:Name="Label1" Content="Sorting &amp; Searching Algorithms" Margin="73,132,0,0" VerticalAlignment="Top" FontSize="14" FontFamily="Segoe Print" Height="35" HorizontalAlignment="Left" Width="239">
