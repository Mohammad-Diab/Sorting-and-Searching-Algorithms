<Window x:Class="Sorting.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="خوارزميات الترتيب" Height="335" Width="380" FlowDirection="RightToLeft" Icon="Icon.ico" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded_1">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFF3F7F2" Offset="0"/>
            <GradientStop Color="White" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid Margin="0,0,0,0">
        <Button Background="{x:Null}" HorizontalAlignment="Left" Margin="106,25,0,0" x:Name="Random" VerticalAlignment="Top" Click="Random_Click" Content="توليد أرقام عشوائية" Height="25" />
        <TextBox HorizontalAlignment="Left" Margin="10,25,0,0" Name="textBox3" Width="91" Height="25" VerticalAlignment="Top" Background="#7FFFFFFF" MaxLength="10" MaxLines="1" AutoWordSelection="True" />
        <Label x:Name="Label1" Content="عدد الأرقام :" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Top"/>
        <Label x:Name="info" Content="مجال الأرقام من (0) حتى (1000000000)" Margin="100,2,0,0" VerticalAlignment="Top" FontSize="11" HorizontalAlignment="Left"/>
        <GroupBox x:Name="GroupBox1" Header="خوارزميات الترتيب" HorizontalAlignment="Left" Height="230" Margin="10,60,0,0" VerticalAlignment="Top" Width="140" BorderBrush="Black">
            <Grid Margin="0,0,0,0">
                <Button Content="ترتيب بالاختيار" Height="32" VerticalAlignment="Top" Background="{x:Null}" x:Name="Selection" Click="Selection_Click" Margin="10,10,10,0" />
                <Button Background="{x:Null}" Content="ترتيب بالفقاعات" Height="32" Margin="10,55,10,0" x:Name="Bubble" VerticalAlignment="Top" Click="Bubble_Click" />
                <Button Background="{x:Null}" Content="ترتيب بالاقحام" Height="32" Margin="10,95,10,0" x:Name="Insertion" VerticalAlignment="Top" Click="Insetion_Click" />
                <Button Background="{x:Null}" Content="ترتيب بالدمج" Height="32" Margin="10,135,10,0" x:Name="Marge" VerticalAlignment="Top" Click="Merge_Click" />
                <Button Background="{x:Null}" Content="فرز سريع" Height="32" Margin="10,175,10,0" x:Name="Quick" VerticalAlignment="Top" Click="Quick_Click" />
            </Grid>
        </GroupBox>
        <GroupBox x:Name="GroupBox2" Margin="160,60,0,0" Header="خوارزميات البحث" HorizontalAlignment="Left" Width="140" Height="167" VerticalAlignment="Top" BorderBrush="Black">
            <Grid>
                <Label x:Name="Label2" Content="بحث عن:" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
                <TextBox x:Name="TextBox1" Height="20" TextWrapping="Wrap" Text="48600" VerticalAlignment="Top" Margin="40,36,10,0" TextAlignment="Center" Background="#7FFFFFFF"/>
                <Button x:Name="Linear" Content="بحث خطي" Height="32" VerticalAlignment="Top" Background="{x:Null}" Click="Linear_Click" Margin="10,65,10,0"/>
                <Button x:Name="Binary" Content="بحث ثنائي" Height="32" Margin="10,105,10,0" VerticalAlignment="Top" Background="{x:Null}" Click="Binary_Click"/>
            </Grid>
        </GroupBox>
        <ListBox x:Name="Numbers_List" HorizontalAlignment="Left" Margin="310,91,0,10" Width="140" Background="#7FFFFFFF" Visibility="Collapsed"/>
        <CheckBox x:Name="View_Number" Content="عرض الأعداد" HorizontalAlignment="Left" Margin="191,278,0,0" VerticalAlignment="Top" Background="{x:Null}" Unchecked="View_Number_Unchecked" Checked="View_Number_Checked"/>
        <Button x:Name="Setting" HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="25" Margin="0,3,3,0" Click="Setting_Click" ToolTip="خيارات" Background="{x:Null}">
            <Button.Content>
                <Image Source="Setting.png" Stretch="Uniform"/>
            </Button.Content>
        </Button>
        <Button x:Name="Help" HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="25" Margin="0,33,3,0" ToolTip="شرح البرنامج" Click="Help_Click" Background="{x:Null}">
            <Button.Content>
                <Image Stretch="Uniform" Source="Help.png"/>
            </Button.Content>
        </Button>
        <Button x:Name="about" Margin="0,63,3,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="32" Height="25" ToolTip="عن" Click="about_Click" Background="{x:Null}" >
            <Button.Content>
                <Image Source="about.png" Stretch="Uniform"/>
            </Button.Content>
        </Button>
        <Button x:Name="button" Content="Built-in Sort" HorizontalAlignment="Left" Height="32" Margin="177,232,0,0" VerticalAlignment="Top" Background="{x:Null}" Width="108" Click="Sort_Click"/>
    </Grid>
</Window>
