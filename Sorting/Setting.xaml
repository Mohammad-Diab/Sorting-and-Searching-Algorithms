<Window x:Class="Sorting.Setting"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="خيارات" Height="210" Width="400" FlowDirection="RightToLeft" Loaded="Window_Loaded_1" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Icon="Setting.png">
    <Grid>
        <CheckBox x:Name="save" Content="حفظ الأعداد المرتبة وغير المرتبة الى القرص الصلب." HorizontalAlignment="Left" Margin="10,15,0,0" VerticalAlignment="Top"/>
        <Label x:Name="Label1" Content="مجال الأعداد:" HorizontalAlignment="Left" Margin="10,40,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="First" HorizontalAlignment="Left" Margin="60,71,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="130" Text="0" TextAlignment="Center" MaxLength="18" MaxLines="1"/>
        <Label x:Name="Label2" Content="من:" HorizontalAlignment="Left" Margin="20,66,0,0" VerticalAlignment="Top"/>
        <Label x:Name="Label3" Content="الى:" HorizontalAlignment="Left" Margin="215,66,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="Last" HorizontalAlignment="Left" Margin="250,71,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="130" Text="1000000000" TextAlignment="Center" MaxLines="1" MaxLength="18"/>
        <Button x:Name="Save_Set" Content="حفظ" HorizontalAlignment="Right" Margin="0,0,90,10" VerticalAlignment="Bottom" Width="75" Background="{x:Null}" Height="25" Click="Save_Setting"/>
        <Button x:Name="Cancel1" Content="الغاء" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Width="75" Background="{x:Null}" Click="Cancel" Height="25"/>
        <Label x:Name="Label4" Content="اللغة:" HorizontalAlignment="Left" Margin="10,100,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="Languages" HorizontalAlignment="Left" Margin="80,103,0,0" VerticalAlignment="Top" Width="131" SelectedIndex="0">
            <ComboBoxItem  Content="العربية"/>
            <ComboBoxItem  Content="English"/>
        </ComboBox>
        <Button x:Name="Default" Content="الافتراضي" Margin="10,0,0,10" VerticalAlignment="Bottom" Background="{x:Null}" Height="25" Click="Default_Setting" HorizontalAlignment="Left" Width="75"/>
    </Grid>
</Window>
